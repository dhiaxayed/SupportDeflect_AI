# Compose environment template: copy/generate the ignored root .env, then supply actual secrets locally.
# This file contains placeholders; production startup rejects an unconfigured application secret/key.
# Prefer scripts/configure.py, which generates all independent secrets without printing them.
# Independent JWT/invitation-encryption secret; changing it invalidates sessions and encrypted pending invitations.
SECRET_KEY=replace-with-at-least-32-random-characters
# URL-safe database password: Compose embeds it in the psycopg connection URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
POSTGRES_USER=supportdeflect
POSTGRES_DB=supportdeflect
# Production guards disable debug/docs/startup schema creation through Compose's fixed settings.
ENVIRONMENT=production
# Browser-visible origin, without a path; HTTP is an isolated-lab baseline and TLS uses the overlay.
PUBLIC_URL=http://localhost
TRUSTED_HOSTS=localhost,127.0.0.1,backend
# The dashboard shares the ingress origin; tenant widget origins use a separate allowlist middleware.
CORS_ORIGINS=[]
# Account-available generation model; timeout is seconds and max tokens bounds generated output/reasoning.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=2048
# For compatible reasoning models (e.g. gpt-oss), set low; otherwise leave empty.
GROQ_REASONING_EFFORT=
# Encoder identity is separate from the offline cache switch documented below.
# Local multilingual encoder; changing its identity requires reindexing persisted passage text.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Retrieval counts are passages/candidates; context/history budgets below count characters, not model tokens.
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_LIMIT=200
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=4000
# Set offline to 1 only after this model exists in the persistent hf_cache volume; fresh volumes need a download.
HF_HUB_OFFLINE=0
# The only cloud API. See docs/AI.md for model availability.
GROQ_API_KEY=
# Worker API secret is separate from JWTs; SMTP defaults to local Mailpit capture, not external inbox delivery.
MAILER_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Separate /mail/ UI password for the fixed admin mailbox username; protect captured invitation messages.
MAILPIT_PASSWORD=replace-with-random-hex-password
SMTP_FROM=dhiaayed03@gmail.com
# Reserve an unused Docker subnet; trusted forwarded headers rely on Traefik's matching fixed address.
EDGE_SUBNET=172.30.80.0/24
TRAEFIK_IPV4=172.30.80.2
# Byte ceiling is 100 MiB; per-plan limits still apply. Request-rate settings count admissions per minute.
MAX_UPLOAD_BYTES=104857600
WIDGET_RATE_LIMIT_PER_MINUTE=20
ADMIN_RATE_LIMIT_PER_MINUTE=120
# Bootstrap script prompts securely when these are omitted.
# SUPERADMIN_EMAIL=operator@example.com
# SUPERADMIN_NAME=Platform Administrator
# Do not keep SUPERADMIN_PASSWORD here; prefer the secure CLI prompt.
