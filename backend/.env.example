# Native development configuration template; copy to ignored backend/.env and supply independent real secrets.
# Root Compose uses a separate .env/database; do not point test utilities at a normal user database.
# Native development only. Compose uses the repository-root .env instead.
# Debug/API docs are local conveniences; schema creation stays explicit through Alembic.
ENVIRONMENT=local
DEBUG=true
DOCS_ENABLED=true
INIT_DATABASE_ON_STARTUP=false
# JWT and encrypted invitations depend on this secret; replace the placeholder before use.
SECRET_KEY=replace-with-a-random-secret-before-use
# Relative SQLite path resolves from the backend process working directory, normally backend/.
DATABASE_URL=sqlite:///./supportdeflect.db
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
# Native Vite origins are explicitly allowed; public widget domains are configured per tenant instead.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENFORCE_TRUSTED_HOSTS=true
TRUSTED_HOSTS=localhost,127.0.0.1

# Real Groq generation uses a configured account/model; timeouts are seconds and output limits are tokens.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=2048
# For compatible reasoning models (e.g. gpt-oss), set low; otherwise leave empty.
GROQ_REASONING_EFFORT=
# Local raster logo files require protection alongside the database; the mailer token must match its worker.
WIDGET_ASSETS_DIRECTORY=./data/widget-assets
MAILER_SERVICE_TOKEN=
MAIL_FROM=dhiaayed03@gmail.com

# Embeddings run locally at the persisted 384-dimensional schema; fake/memory providers are test-only.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
ALLOW_FAKE_EMBEDDINGS_FALLBACK=false
VECTOR_PROVIDER=database
INGESTION_MODE=queued
# Worker idle polling is seconds; attempts count bounded automatic processing tries before failure.
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_JOB_MAX_ATTEMPTS=3
# Chunk size/overlap and context/history budgets count characters; overlap must remain smaller than size.
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_LIMIT=200
RAG_CONTEXT_MAX_CHARS=10000
RAG_HISTORY_MAX_CHARS=4000
# Global byte ceiling is 100 MiB; tenant plan caps also apply. URL fetch timeout is seconds.
MAX_UPLOAD_BYTES=104857600
REQUEST_TIMEOUT_SECONDS=20
URL_MAX_REDIRECTS=5
# Database-backed rolling request accounting is shared across processes; limits below are requests/minute.
RATE_LIMIT_PROVIDER=database
ADMIN_RATE_LIMIT_PER_MINUTE=120
WIDGET_RATE_LIMIT_PER_MINUTE=20
