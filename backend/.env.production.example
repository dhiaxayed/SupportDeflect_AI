# Native production reference template; prefer Compose's root environment for the canonical Linux stack.
# Placeholder secrets/key must be replaced privately; these sample internal DNS names require matching networking.
# Reference for a native production process; prefer the root Compose environment.
# Enforce production validation: no debug/docs/implicit schema creation, explicit hosts and real providers.
ENVIRONMENT=production
DEBUG=false
DOCS_ENABLED=false
INIT_DATABASE_ON_STARTUP=false
# This independent secret signs JWTs and derives invitation encryption; rotation affects both kinds of state.
SECRET_KEY=replace-with-at-least-32-random-characters
# URL-safe password and reachable PostgreSQL host are operator inputs; migrations run before serving.
DATABASE_URL=postgresql+psycopg://supportdeflect:replace-password@postgres:5432/supportdeflect
FRONTEND_URL=https://support.example.com
BACKEND_PUBLIC_URL=https://support.example.com
CORS_ORIGINS=[]
ENFORCE_TRUSTED_HOSTS=true
TRUSTED_HOSTS=support.example.com,localhost,127.0.0.1,backend
# Trust only the actual reverse proxy's fixed address, never arbitrary client-supplied forwarded headers.
FORWARDED_ALLOW_IPS=172.30.80.2
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
WIDGET_ASSETS_DIRECTORY=./data/widget-assets
# Independent worker API token must match the mailer and have at least 32 characters; SMTP is configured there.
MAILER_SERVICE_TOKEN=
MAIL_FROM=dhiaayed03@gmail.com
GROQ_API_KEY=
# Local multilingual 384-dimensional model requires cache/bootstrap access and reindexing after identity changes.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
ALLOW_FAKE_EMBEDDINGS_FALLBACK=false
VECTOR_PROVIDER=database
INGESTION_MODE=queued
# Poll/fetch timeouts are seconds; upload ceilings are bytes and request throttles are per minute.
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_JOB_MAX_ATTEMPTS=3
MAX_UPLOAD_BYTES=104857600
REQUEST_TIMEOUT_SECONDS=20
URL_MAX_REDIRECTS=5
RATE_LIMIT_PROVIDER=database
ADMIN_RATE_LIMIT_PER_MINUTE=120
WIDGET_RATE_LIMIT_PER_MINUTE=20
