# Native worker example: copy to mailer/.env for explicit local Mailpit capture.
# Secrets are examples only. Keep MAILER_SERVICE_TOKEN identical to the backend
# private token, with at least 32 characters; never expose it to frontend variables.
MAILER_API_URL=http://127.0.0.1:8000/api/v1
MAILER_SERVICE_TOKEN=replace-with-the-same-random-32-character-secret-as-backend
# Port 1025 is Mailpit SMTP (its browser inbox uses another port). Unencrypted mode
# is allowed only for mailpit/localhost/127.0.0.1; remote SMTP requires TLS and auth.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_ALLOW_INSECURE_LOCAL=true
SMTP_FROM=dhiaayed03@gmail.com
# Local Mailpit only. No Gmail credentials are needed for this project's baseline.
